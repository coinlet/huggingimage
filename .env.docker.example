# Copy to .env on the deployment machine and set your workspace login token.
ADMIN_TOKEN=
# Set to 0.0.0.0 when publishing directly on a server's network interfaces.
PUBLISH_HOST=127.0.0.1
PUBLISH_PORT=3001
# Optional. Leave empty to generate and persist a key in the data volume.
ENCRYPTION_KEY=
# Optional text model for AI-assisted Space configuration.
CONFIG_AI_BASE_URL=
CONFIG_AI_MODEL=
CONFIG_AI_API_KEY=
