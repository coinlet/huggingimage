HOST=127.0.0.1
PORT=3001
# Set a strong token before exposing the application outside your own computer.
# All application data belongs to this single-user workspace.
ADMIN_TOKEN=
# Optional: base64-encoded 32-byte key. Otherwise generated in data/.encryption-key.
ENCRYPTION_KEY=
DATA_DIR=./data
# Optional reference gallery root containing img/ and thumbs/.
# If empty, checks DATA_DIR/reference-gallery and ../ai-pose-gallery-zh.
REFERENCE_GALLERY_DIR=
# Optional AI assistant for interpreting unusual Gradio API schemas.
# Only the API schema is sent; never the HF Token or uploaded images.
# Leave all three blank to use local schema inference without an extra AI key.
CONFIG_AI_BASE_URL=
CONFIG_AI_MODEL=
CONFIG_AI_API_KEY=
